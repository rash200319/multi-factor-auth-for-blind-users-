# Copy to .env and fill in. Generate SESSION_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

RP_NAME=MFA for Blind Users (Demo)
RP_ID=localhost
ORIGIN=http://localhost:5190
PORT=4000
SESSION_SECRET=
DB_PATH=./mfa.sqlite
NODE_ENV=development

# Only needed when the client is served through an HTTPS tunnel on its own
# domain (see tools/README.md) — client and server become cross-site, so the
# session cookie needs SameSite=None + Secure instead of the localhost-dev
# defaults. Leave both commented out for ordinary localhost dev.
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
