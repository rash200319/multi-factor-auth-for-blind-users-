# Copy to .env and fill in. Generate SESSION_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

RP_NAME=MFA for Blind Users (Demo)
RP_ID=localhost
ORIGIN=http://localhost:5190
PORT=4000
SESSION_SECRET=
DB_PATH=./mfa.sqlite
NODE_ENV=development

# Only needed when the client is served through an HTTPS tunnel on its own
# domain (see tools/README.md) — client and server become cross-site, so the
# session cookie needs SameSite=None + Secure instead of the localhost-dev
# defaults. Leave both commented out for ordinary localhost dev.
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true

# DEV ONLY. Lets enrolment skip the roaming security key for testers who
# don't own one — the account then has no roaming-key recovery tier and no
# WCAG SC 3.3.8 alternative to the spoken step-up code (written recovery
# codes still work). Never enable outside local development.
# DEV_ALLOW_SKIP_SECURITY_KEY=true

# Out-of-band notification delivery for lockout + recovery-tier-4 alerts
# (docs/hardening-plan.md WI-0). "console" logs to stdout — zero config,
# the default. "smtp" sends real email via the SMTP_* settings below.
NOTIFY_CHANNEL=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# Recovery tier 4 (docs/hardening-plan.md WI-3) — mandatory delay, in hours,
# before an out-of-band identity-proofing recovery request can complete.
RECOVERY_TIER4_DELAY_HOURS=72

# Step-up rate limiting (docs/hardening-plan.md WI-4) — max requests per
# window, keyed on the authenticated user (falls back to IP).
STEPUP_RATE_LIMIT_WINDOW_MINUTES=15
STEPUP_CHALLENGE_RATE_LIMIT=5
STEPUP_VERIFY_RATE_LIMIT=10
