{
  "name": "mfa-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --experimental-sqlite --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env --experimental-sqlite dist/index.js",
    "test": "node --env-file=.env.test --experimental-sqlite --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@simplewebauthn/server": "^10.0.1",
    "@simplewebauthn/types": "^10.0.0",
    "@node-rs/argon2": "^2.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
